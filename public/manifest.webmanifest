{
  "name": "Noble — Voice Executive Assistant",
  "short_name": "Noble",
  "description": "Bilingual voice-first executive assistant: notes, tasks, meetings, contacts, and Bluetooth transfer between devices.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#faf6ef",
  "theme_color": "#e85d3d",
  "orientation": "portrait",
  "icons": [
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "/receive",
      "accept": { "application/json": [".noble.json", ".json"] }
    }
  ]
}

